<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
		  xmlns:tools="http://schemas.android.com/tools"
		  tools:ignore="GoogleAppIndexingWarning">

	<!-- Android 5 - 9 only: the built-in Download destination is written to the public
		 Download folder there (MediaStore.Downloads does not exist before Android 10).
		 Never granted or requested on Android 10+, where MediaStore needs no permission and
		 user folders use Storage Access Framework grants. No MANAGE_EXTERNAL_STORAGE. -->
	<uses-permission
		android:name="android.permission.WRITE_EXTERNAL_STORAGE"
		android:maxSdkVersion="28" />
	<uses-permission
		android:name="android.permission.READ_EXTERNAL_STORAGE"
		android:maxSdkVersion="28" />
	<!-- Downloading shared links. A normal permission, granted at install. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Save result notifications. Requested once from the main screen on Android 13+;
		 saving works without it. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<application
		android:name=".DropFilerApplication"
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.FileSaver"
		android:fullBackupContent="@xml/backup_descriptor">
		<activity
			android:name=".activity.FolderListActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />

				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<!-- Sharing shortcuts (Direct Share on Android 10+) -->
			<meta-data
				android:name="android.app.shortcuts"
				android:resource="@xml/shortcuts" />
		</activity>
		<activity
			android:name=".activity.CreditsActivity"
			android:exported="false"
			android:label="@string/title_activity_credits"
			android:parentActivityName=".activity.FolderListActivity" />
		<!-- Share target: must stay exported so other apps can share to it -->
		<activity
			android:name=".activity.SaverActivity"
			android:exported="true"
			android:theme="@style/Theme.FileSaver.Sheet">
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="*/*" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.SEND_MULTIPLE" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="*/*" />
			</intent-filter>
			<!-- "Open with DropFiler": saves a copy of the opened file (intent data) to a
				 destination. It does not view or edit files. content:// is the normal case;
				 file:// is a best-effort fallback for older apps (readable on Android 9 and older
				 with the legacy permission; usually unreadable on newer versions, which is
				 reported instead of saving). No BROWSABLE / http(s): web links are not handled. -->
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:scheme="content" />
				<data android:scheme="file" />
				<data android:mimeType="*/*" />
			</intent-filter>
			<!-- Direct Share on Android 6.0 - 9 -->
			<meta-data
				android:name="android.service.chooser.chooser_target_service"
				android:value=".service.LocationChooserTargetService" />
		</activity>
		<activity
			android:name=".activity.SettingsActivity"
			android:exported="false"
			android:label="@string/title_activity_settings"
			android:parentActivityName=".activity.FolderListActivity" />

		<!-- Bound by the system chooser only; protected by BIND_CHOOSER_TARGET_SERVICE -->
		<service android:name=".service.LocationChooserTargetService"
			android:exported="true"
			android:label="@string/app_name"
			android:permission="android.permission.BIND_CHOOSER_TARGET_SERVICE"
			tools:ignore="ExportedService"
			tools:targetApi="m">
			<intent-filter>
				<action android:name="android.service.chooser.ChooserTargetService" />
			</intent-filter>
		</service>
	</application>

</manifest>
