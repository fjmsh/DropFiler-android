	<!-- Settings -->
	<string name="title_activity_settings">Settings</string>

	<string name="pref_title_file_exists">Behaviour if file already exists</string>
	<array name="pref_list_title_file_exists">
		<item>Overwrite existing</item>
		<item>Do not save</item>
		<item>Append number to name</item>
		<!--<item>Request new name</item>-->
	</array>
	<array name="pref_list_description_file_exists">
		<item>Overwrite existing file with new file</item>
		<item>Do not save the new file</item>
		<item>Append number to file name so both files are saved</item>
		<!--<item>Request new file name with a pop up</item>-->
	</array>
	<string name="pref_default_value_file_exists">Overwrite</string>
	<array name="pref_list_values_file_exists">
		<item>Overwrite</item>
		<item>Nothing</item>
		<item>Postfix</item>
		<!--<item>Request</item>-->
	</array>

	<string name="pref_title_location_select">Enable location select</string>
	<string name="pref_description_location_select">Offer \"Choose location when saving\" in the
		share sheet. Saves a single copy wherever you pick with Android\'s file picker, without adding a
		save destination.
	</string>

	<string name="pref_title_register_file">Register with media scanner</string>
	<string name="pref_description_register_file">Notify the media scanner when a file has been
		saved to Download on Android 9 and older. On Android 10 and newer, files saved to Download are
		always added to the media library, and folders you added are handled by their storage provider.
	</string>

	<string name="pref_title_lenient_regex">Use lenient filename validation</string>
	<string name="pref_description_lenient_regex">When this setting is disabled, filenames are limited
		to alphanumeric characters, underscores and hyphens. When enabled, filenames are not restricted.
		This adds support for non-Latin characters and languages, emoji etc. WARNING: This may cause
		some files to not save, or may break applications that do not support these characters.
	</string>

	<string name="pref_title_follow_redirects">Follow redirects</string>
	<string name="pref_description_follow_redirects">When a link redirects to another page, &appname;
		will follow the redirect to the new page.
	</string>

	<string name="pref_title_force_saving">Force saving</string>
	<string name="pref_description_force_saving">Force a shared item to save even if it does not have
		explicit support. WARNING: Saving with this feature enabled may have adverse effects.
	</string>


